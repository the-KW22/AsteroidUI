{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "asteroidui",
  "homepage": "http://localhost:3000",
  "items": [
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "An action button with optional interaction feedback and application-controlled loading.",
      "dependencies": ["@base-ui/react@1.9.0", "class-variance-authority@0.7.1"],
      "registryDependencies": [
        "http://localhost:3000/registry/spinner.json",
        "http://localhost:3000/registry/utils.json",
        "http://localhost:3000/registry/library-styles.json"
      ],
      "files": [
        { "path": "src/components/ui/button.tsx", "type": "registry:ui", "target": "@ui/button.tsx" }
      ]
    },
    {
      "name": "input",
      "type": "registry:ui",
      "title": "Input",
      "description": "A native text field with shared styling and native form semantics.",
      "registryDependencies": [
        "http://localhost:3000/registry/utils.json",
        "http://localhost:3000/registry/library-styles.json"
      ],
      "files": [
        {
          "path": "src/components/ui/input.tsx",
          "type": "registry:ui",
          "target": "@ui/input.tsx"
        }
      ]
    },
    {
      "name": "textarea",
      "type": "registry:ui",
      "title": "Textarea",
      "description": "A multiline native text field with vertical resizing.",
      "registryDependencies": [
        "http://localhost:3000/registry/utils.json",
        "http://localhost:3000/registry/library-styles.json"
      ],
      "files": [
        {
          "path": "src/components/ui/textarea.tsx",
          "type": "registry:ui",
          "target": "@ui/textarea.tsx"
        }
      ]
    },
    {
      "name": "label",
      "type": "registry:ui",
      "title": "Label",
      "description": "A native label associating visible text with a form control.",
      "registryDependencies": [
        "http://localhost:3000/registry/utils.json",
        "http://localhost:3000/registry/library-styles.json"
      ],
      "files": [
        {
          "path": "src/components/ui/label.tsx",
          "type": "registry:ui",
          "target": "@ui/label.tsx"
        }
      ]
    },
    {
      "name": "checkbox",
      "type": "registry:ui",
      "title": "Checkbox",
      "description": "A labeled choice supporting checked and indeterminate states.",
      "dependencies": [
        "@base-ui/react@1.9.0",
        "lucide-react@1.56.0"
      ],
      "registryDependencies": [
        "http://localhost:3000/registry/utils.json",
        "http://localhost:3000/registry/library-styles.json"
      ],
      "files": [
        {
          "path": "src/components/ui/checkbox.tsx",
          "type": "registry:ui",
          "target": "@ui/checkbox.tsx"
        }
      ]
    },
    {
      "name": "radio-group",
      "type": "registry:ui",
      "title": "Radio group",
