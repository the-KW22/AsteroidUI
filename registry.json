      "dependencies": [
        "@base-ui/react@1.9.0",
        "lucide-react@1.56.0"
      ],
      "registryDependencies": [
        "http://localhost:3000/registry/utils.json",
        "http://localhost:3000/registry/library-styles.json"
      ],
      "files": [
        {
          "path": "src/components/ui/radio-group.tsx",
          "type": "registry:ui",
          "target": "@ui/radio-group.tsx"
        }
      ]
    },
    {
      "name": "select",
      "type": "registry:ui",
      "title": "Select",
      "description": "A keyboard-accessible dropdown for choosing a predefined value.",
      "dependencies": [
        "@base-ui/react@1.9.0",
        "lucide-react@1.56.0"
      ],
      "registryDependencies": [
        "http://localhost:3000/registry/utils.json",
        "http://localhost:3000/registry/library-styles.json"
      ],
      "files": [
        {
          "path": "src/components/ui/select.tsx",
          "type": "registry:ui",
          "target": "@ui/select.tsx"
        }
      ]
    },
    {
      "name": "switch",
      "type": "registry:ui",
      "title": "Switch",
      "description": "A keyboard-accessible control for a binary setting.",
      "dependencies": [
        "@base-ui/react@1.9.0"
      ],
      "registryDependencies": [
        "http://localhost:3000/registry/utils.json",
        "http://localhost:3000/registry/library-styles.json"
      ],
      "files": [
        {
          "path": "src/components/ui/switch.tsx",
          "type": "registry:ui",
          "target": "@ui/switch.tsx"
        }
      ]
    },
    {
      "name": "spinner",
      "type": "registry:ui",
      "title": "Spinner",
      "description": "A reusable loading ring with standalone status and decorative modes.",
      "dependencies": ["lucide-react@1.56.0"],
      "registryDependencies": [
        "http://localhost:3000/registry/utils.json",
        "http://localhost:3000/registry/library-styles.json"
      ],
      "files": [
        { "path": "src/components/ui/spinner.tsx", "type": "registry:ui", "target": "@ui/spinner.tsx" }
      ]
    },
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "Class name utilities",
      "description": "The class name merging helper used by library components.",
      "dependencies": ["clsx@2.1.1", "tailwind-merge@3.7.0"],
      "files": [
        { "path": "src/lib/utils.ts", "type": "registry:lib", "target": "@lib/utils.ts" },
        { "path": "THIRD_PARTY_NOTICES.md", "type": "registry:file", "target": "@ui/THIRD_PARTY_NOTICES.md" },
        { "path": "LICENSE", "type": "registry:file", "target": "@ui/LICENSE" }
      ]
    },
    {
      "name": "library-styles",
      "type": "registry:file",
      "title": "Library styles",
      "description": "Shared color, font, radius, and component interaction styles. Import this file once from the consumer's global stylesheet.",
      "files": [
        { "path": "src/styles/library.css", "type": "registry:file", "target": "@ui/library.css" }
      ]
    }
  ]
}
