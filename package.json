{
  "name": "asteroidui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/the-KW22/AsteroidUI.git" },
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.12.1"
  },
  "scripts": {
    "dev": "node scripts/registry.mjs dev && next dev",
    "build": "npm run registry:build && npm run registry:validate && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test:foundation": "playwright test tests/foundation.spec.ts",
    "test": "playwright test",
    "test:consumers": "playwright test --config playwright.consumers.config.ts",
    "registry:build": "node scripts/registry.mjs build",
    "registry:configure": "node scripts/registry.mjs configure",
    "registry:validate": "node scripts/registry.mjs",
    "test:registry": "node --test scripts/registry.test.mjs"
  },
  "dependencies": {
    "@next/env": "16.4.0",
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.56.0",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "postcss": "8.5.30",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
